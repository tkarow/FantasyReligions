function Get-GodGender{

    $GenderRoll = ''
    $GenderRoll = Get-Random -Minimum 1 -Maximum 101

    $Gender = ''

    if($GenderRoll -le 60){$Gender = "Male"}
    if(($GenderRoll -gt 60) -and ($GenderRoll -le 96)){$Gender = "Female"}
    if(($GenderRoll -gt 96) -and ($GenderRoll -le 99)){$Gender = "Other"}
    if($GenderRoll -eq 100){$Gender = @("Hermaphroditic","Female")[(Get-Random -Minimum 0 -Maximum 2)]}

    $Gender

}

function Get-GodName{

    Param(
        [Parameter(Mandatory=$False)]
        $GodInfo,
        [Parameter(Mandatory=$False)]
        [ValidateSet("Male","Female","Other","Hermaphroditic")]
        $Gender
    )

    if(($Gender -like '') -or ($Gender -like $null)){$Gender = Get-GodGender}

    if(($GodInfo -like $null) -or ($GodInfo -like '')){$GodInfo = $UltraCuratedDNDDomains[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $UltraCuratedDNDDomains))]}

    $Syllables = @()

    $SpecificSyllables = ''
    $SpecificSyllables = $GodInfo.Syllables

    $SpecificSyllable = ''
    $SpecificSyllable = $SpecificSyllables[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $SpecificSyllables))]

    $Syllables += $SpecificSyllable

    if((Get-Random -Minimum 1 -Maximum 10) -eq 10){
    
        $RemainingSpecificSyllables = ''
        $RemainingSpecificSyllables = $SpecificSyllables | ?{$_ -ne $SpecificSyllable}

        $Syllables += $RemainingSpecificSyllables[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $RemainingSpecificSyllables))]
        
    }

    $RandomSyllables = @("Dus","Per","Trum","Den","Vas","Ma","Din","Then","Dag","Vel","Osh","Mor","Bri","Tar","Cer")

    $RandomSyllable = ''

    if((Get-Random -Minimum 1 -Maximum 21) -lt 5){
    
        $RandomSyllable = $RandomSyllables[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $RandomSyllables))]

        $Syllables += $RandomSyllable

    }

    if((Get-Random -Minimum 1 -Maximum 11) -eq 10){
    
        $RemainingRandomSyllables = ''
        $RemainingRandomSyllables = $RandomSyllables | ?{$_ -ne $RandomSyllable}

        $Syllables += $RemainingRandomSyllables[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $RemainingRandomSyllables))]
        
    }

    $Name = ''

    foreach($BuildingBlock in 0..($Syllables | Measure).Count){
    
        $Block = ''
        
        if($Syllables.Count -gt 1){$Block = $Syllables[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $Syllables))]}else{$Block = $Syllables}

        $Syllables = $Syllables | ?{$_ -ne "$($Block)"}

        $Name = "$($Name)$($Block)"

    }

    $MaleSuffixes = @("ox","tis","chos","is","us","mo","nus","id","ir","gus")

    if($Gender -eq "Male"){$Name = "$($Name)$($MaleSuffixes[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $MaleSuffixes))])"}

    $FemaleSuffixes = @("oxia","tisa","chosa","isa","ia","ma","nia","rid","a","gia")

    if($Gender -eq "Female"){$Name = "$($Name)$($FemaleSuffixes[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $FemaleSuffixes))])"}

    $Name = $Name.Replace('pp','p')
    $Name = $Name.Replace('aa','a')

    if($Name -like "*kox"){$Name = $Name.Replace('kox','ktox')}
    if($Name -like "*cox"){$Name = $Name.Replace('cox','ctox')}

    $Name = $Name.ToLower()
    $Name = $Name.Substring(0,1).ToUpper() + $Name.Substring(1)

    $Name

}

function Get-StarName{

    $Name = ''

    $FirstPart = ''
    $FirstPart = $StarFirstParts[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $StarFirstParts))]

    $SecondPart = ''
    $SecondPart = $StarSecondParts[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $StarSecondParts))]

    $ThirdPart = ''
    if((Get-Random -Minimum 1 -Maximum 6) -eq 1){$ThirdPart = " of $($StarThirdParts[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $StarThirdParts))])"}
    if(($ThirdPart -eq '') -or ($ThirdPart -eq $null)){if((Get-Random -Minimum 1 -Maximum 11) -eq 1){$Name = "The $($SecondPart) of $(Get-GodName -GodInfo ($SpecificDomains | ?{$_.Domain -eq 'A Specific Star'}))"}}

    if(($Name -like '') -or ($Name -eq $null)){

        $Name = ''
        $Name = "$($FirstPart) $($SecondPart)"
        if($Name -notlike "* of the *"){$Name = "$($FirstPart) $($SecondPart)$($ThirdPart)"}

        $Name = $Name.Replace('of the of the','of the')
        $Name = $Name.Replace('of the Wisdom','of Wisdom')
        $Name = $Name.Replace('of the Doom','of Doom')
        $Name = $Name.Replace(' of of ',' of ')
        if($Name -eq 'The Arrow of the Lance'){$Name = "$(Get-GodName -GodInfo ($SpecificDomains | ?{$_.Domain -eq 'A Specific Star'}))'s Lance"}
        if(($SecondPart -like "Wisdom") -and ($Name -like "The*")){$Name = "$($Name.Substring(4))"}

    }

    $Name

}

