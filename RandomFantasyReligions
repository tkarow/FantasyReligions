function Get-GodIncidentals{

    Param(
        [Parameter(Mandatory=$False)]
        $GodInfo,
        [Parameter(Mandatory=$False)]
        [ValidateSet("Male","Female","Other","Hermaphroditic")]
        $Gender
    )

    if(($Gender -like '') -or ($Gender -like $null)){$Gender = Get-GodGender}

    if(($GodInfo -like $null) -or ($GodInfo -like '')){$GodInfo = $UltraCuratedDNDDomains[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $UltraCuratedDNDDomains))]}

    $RootDomain = ''
    $RootDomain = $GodInfo.Domain

    $AlternateDomains = ''
    $AlternateDomains = $GodInfo.AlternateDomains
    #Add and weight the domain's primary name x2
    $AlternateDomains += $GodInfo.Domain
    $AlternateDomains += $GodInfo.Domain

    $DomainName = ''
    $DomainName = $AlternateDomains[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $AlternateDomains))]

    if($SpecificDomains.Domain -contains $DomainName){
    
        $GodInfo = $SpecificDomains | ?{$_.Domain -like $DomainName}

        $AlternateDomains = ''
        $AlternateDomains = $GodInfo.Specifics

        $DomainName = $AlternateDomains[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $AlternateDomains))]

        if($SpecificDomains.Domain -eq 'A Specific Star'){$AlternateDomains = "$(Get-StarName)"}

    }

    $Iconography = ''
    $Iconography = if(($GodInfo.Iconography).Count -eq 1){$GodInfo.Iconography}else{$GodInfo.Iconography[(Get-Random -Minimum 0 -Maximum (Get-ArrayCount $GodInfo.Iconography))]}

    #region Exceptions

    if(($Iconography -eq 'A Specific Musical Instrument') -or ($Iconography -eq 'A Musical Instrument')){
    
